<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E2E8F0"
    app:cardCornerRadius="8dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header row: Date + Follow-up chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvNoteDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
                android:textColor="#185FA5" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFollowUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                app:chipMinHeight="24dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:background="#E2E8F0"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp" />

        <!-- Diagnosis -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diagnosis"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/tvDiagnosis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:textColor="#1A2535"
            android:layout_marginBottom="8dp" />

        <!-- Symptoms -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Symptoms"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/tvSymptoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:textColor="#1A2535"
            android:layout_marginBottom="8dp" />

        <!-- Observations -->
        <TextView
            android:id="@+id/labelObservations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Observations"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/tvObservations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:textColor="#1A2535"
            android:layout_marginBottom="8dp" />

        <!-- Treatment Plan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Treatment Plan"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/tvPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:textColor="#1A2535" />

        <!-- Divider -->
        <View
            android:background="#E2E8F0"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <!-- Action Row: Edit + Delete icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <ImageView
                android:id="@+id/btnEditNote"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit"
                android:src="@drawable/ic_edit_24"
                app:tint="#64748B" />

            <ImageView
                android:id="@+id/btnDeleteNote"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete"
                android:src="@drawable/ic_delete_24"
                app:tint="#EF4444" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>