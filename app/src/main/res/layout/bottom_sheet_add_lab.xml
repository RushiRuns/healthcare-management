<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textLabSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Add Lab Result"
        android:textColor="@color/patient_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputTestName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_bg"
        android:hint="Test Name (e.g., Complete Blood Count)"
        android:padding="16dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/inputTestDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_bg"
        android:hint="Test Date (YYYY-MM-DD)"
        android:focusable="false"
        android:clickable="true"
        android:padding="16dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/inputResultValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:hint="Result Value"
            android:padding="16dp"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/inputUnit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:hint="Unit (e.g., mg/dL)"
            android:padding="16dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/inputReferenceRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_bg"
        android:hint="Reference Range (e.g., 70 - 99)"
        android:padding="16dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status"
        android:textSize="14sp"
        android:textColor="@color/patient_text_secondary" />

    <RadioGroup
        android:id="@+id/radioGroupLabStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/radioNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Normal"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioAbnormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Abnormal" />

        <RadioButton
            android:id="@+id/radioCritical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Critical" />
    </RadioGroup>

    <Button
        android:id="@+id/btnSaveLab"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/patient_primary_blue"
        android:text="Save Lab Result"
        android:textColor="#FFFFFF" />

</LinearLayout>