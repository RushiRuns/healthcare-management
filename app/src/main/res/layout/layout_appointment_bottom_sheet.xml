<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheetLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="32dp"
    android:background="#FFFFFF"
    android:elevation="0dp"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Patient Name -->
    <TextView
        android:id="@+id/sheetPatientName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Overview"
        android:textSize="24sp"
        android:textColor="#1A2535"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="20dp" />

    <!-- Allergies label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Allergies"
        android:textSize="11sp"
        android:textColor="#64748B"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="4dp" />

    <!-- Allergies value -->
    <TextView
        android:id="@+id/sheetAllergies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:textSize="13sp"
        android:textColor="#1A2535"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="16dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="#E2E8F0" />

    <!-- Conditions label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conditions"
        android:textSize="11sp"
        android:textColor="#64748B"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="4dp" />

    <!-- Conditions value -->
    <TextView
        android:id="@+id/sheetConditions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:textSize="13sp"
        android:textColor="#1A2535"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="28dp" />

    <!-- Open Full Record button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenFullRecord"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Open Full Record"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        app:backgroundTint="#185FA5"
        app:elevation="0dp"
        app:cornerRadius="8dp" />

</LinearLayout>