<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F5F7F9">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        app:title="Schedule Appointment"
        app:titleTextColor="#1A2535"
        app:navigationIconTint="#1A2535" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Select Patient"
                android:textColorHint="#64748B"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:startIconTint="#64748B"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#E2E8F0"
                app:boxStrokeWidth="1dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:hintTextColor="#185FA5">
                <AutoCompleteTextView
                    android:id="@+id/searchPatientAuto"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:completionThreshold="0"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#1A2535"
                    android:popupBackground="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="Date"
                android:textColorHint="#64748B"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#E2E8F0"
                app:boxStrokeWidth="1dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:hintTextColor="#185FA5">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editDate" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:focusable="false"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#1A2535" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="Time"
                android:textColorHint="#64748B"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#E2E8F0"
                app:boxStrokeWidth="1dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:hintTextColor="#185FA5">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTime" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:focusable="false"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#1A2535" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="Reason for Visit"
                android:textColorHint="#64748B"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#E2E8F0"
                app:boxStrokeWidth="1dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:hintTextColor="#185FA5">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editReason" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#1A2535" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textPaymentStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Consultation Fee: Pending"
                        android:textColor="#64748B"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchPayment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSchedule"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="32dp" android:text="Schedule Now"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#94A3B8"
                app:backgroundTint="#E2E8F0"
                app:elevation="0dp"
                app:cornerRadius="8dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>