<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F5F7F9">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarReport"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="#1A2535"
        app:title="Report Preview"
        app:titleTextColor="#1A2535">

        <LinearLayout
            android:id="@+id/btnExportPdf"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPORT PDF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#185FA5"
                android:letterSpacing="0.05" />
        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutPrintableArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="24dp"
            android:layout_margin="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PATIENT MEDICAL REPORT"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#000000"
                android:gravity="center"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/reportDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generated: -"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:background="#000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PATIENT NAME"
                        android:textSize="10sp"
                        android:textColor="#64748B"
                        android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/reportPatientName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="14sp" android:textColor="#000000" android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MEDICAL ID"
                        android:textSize="10sp"
                        android:textColor="#64748B"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="12dp" />
                    <TextView android:id="@+id/reportPatientId" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="14sp" android:textColor="#000000" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AGE / GENDER"
                        android:textSize="10sp"
                        android:textColor="#64748B"
                        android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/reportDemographics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="14sp" android:textColor="#000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BLOOD TYPE"
                        android:textSize="10sp"
                        android:textColor="#64748B"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="12dp" />
                    <TextView android:id="@+id/reportBloodType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="14sp" android:textColor="#000000" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#CBD5E1" />

            <TextView
                android:id="@+id/reportContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="13sp"
                android:lineSpacingExtra="6dp"
                android:text="Gathering patient data..." />

        </LinearLayout>
    </ScrollView>
</LinearLayout>