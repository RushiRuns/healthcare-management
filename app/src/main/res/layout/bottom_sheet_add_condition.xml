<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Medical Condition"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/inputConditionName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Condition Name (e.g. Hypertension)"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/inputDiagnosisDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Diagnosis Date (YYYY-MM-DD)"
        android:focusable="false"
        android:clickable="true"
        android:inputType="none"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/radioGroupStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/radioActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/radioResolved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Resolved"/>
    </RadioGroup>

    <Button
        android:id="@+id/btnSaveCondition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Condition"
        android:backgroundTint="@color/patient_primary_blue"
        android:textColor="@android:color/white"/>

</LinearLayout>