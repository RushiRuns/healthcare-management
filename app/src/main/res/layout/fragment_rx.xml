<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="96dp">

            <!-- Section: Active Prescriptions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prescriptions"
                android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
                android:textColor="#1A2535"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTIVE"
                android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
                android:textColor="#185FA5"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewActiveRx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="24dp" />

            <View
            android:background="#E2E8F0"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp" />

            <!-- Section: Past Prescriptions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Past Prescriptions"
                android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
                android:textColor="#1A2535"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PAST"
                android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
                android:textColor="#64748B"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewPastRx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnAddMedication"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Add Medication"
        app:icon="@android:drawable/ic_input_add" 
        app:backgroundTint="#185FA5"
        android:textColor="#FFFFFF"
        app:iconTint="#FFFFFF"
        app:elevation="0dp"
        android:fontFamily="sans-serif-medium" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>