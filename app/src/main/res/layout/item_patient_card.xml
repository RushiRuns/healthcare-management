<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">

        <!-- Avatar -->
        <TextView
            android:id="@+id/textAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_avatar"
            android:backgroundTint="#E2E8F0"
            android:gravity="center"
            android:text="R"
            android:textColor="#1A2535"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/textPatientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rahul Sharma"
                android:textSize="15sp"
                android:textColor="#1A2535"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/textPatientDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="PT-1001 • 45 yrs"
                android:textSize="13sp"
                android:textColor="#64748B"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Arrow -->
        <ImageView
            android:id="@+id/iconArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_chevron_right"
            app:tint="#64748B" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>